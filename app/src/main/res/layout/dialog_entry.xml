<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/dialogEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="34sp"/>

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/daymarkTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stored locally • syncs automatically"
        android:textColor="?attr/daymarkTextSecondary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"/>

    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Write whatever is on your mind…"
        android:minLines="5"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:textColor="?attr/daymarkTextPrimary"
        android:textColorHint="?attr/daymarkTextSecondary"
        android:background="@drawable/bg_category_card"
        android:padding="14dp"/>

    <TextView
        android:id="@+id/dialogCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/daymarkTextSecondary"
        android:textSize="11sp"
        android:text="0 characters"
        android:layout_marginTop="8dp"/>

</LinearLayout>
