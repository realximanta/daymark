<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <!-- 🎨 Emoji badge -->
    <TextView
        android:id="@+id/dialogEmoji"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="@drawable/bg_icon_badge"
        android:textSize="30sp"
        android:includeFontPadding="false"
        android:contentDescription="@null" />

    <!-- 🏷️ Category title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/daymarkTextPrimary"
        android:textSize="24sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginTop="14dp" />

    <!-- 📝 Supportive subtitle -->
    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A safe little space for your thoughts."
        android:textColor="?attr/daymarkTextSecondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp" />

    <!-- ⌨️ Multiline input -->
    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What would you like to remember?"
        android:minLines="5"
        android:maxLines="10"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:textColor="?attr/daymarkTextPrimary"
        android:textColorHint="?attr/daymarkTextSecondary"
        android:background="@drawable/bg_input"
        android:padding="16dp"
        android:textSize="14sp"
        android:importantForAutofill="no"
        android:scrollbars="vertical" />

    <!-- 🔢 Character counter -->
    <TextView
        android:id="@+id/dialogCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/daymarkTextSecondary"
        android:textSize="11sp"
        android:text="0 / 2000"
        android:layout_marginTop="8dp" />
</LinearLayout>
