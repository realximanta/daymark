<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/daymarkBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="?attr/daymarkTextPrimary"
            android:textSize="25sp"
            android:textStyle="bold" />
        <Switch
            android:id="@+id/reminderSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminders"
            android:textColor="?attr/daymarkTextPrimary"
            android:layout_marginTop="22dp" />
        <TextView
            android:id="@+id/reminderTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9:00 PM"
            android:textColor="?attr/daymarkTextSecondary"
            android:textSize="14sp"
            android:paddingTop="6dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminders_summary"
            android:textColor="?attr/daymarkTextSecondary"
            android:textSize="12sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/daymarkStroke"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/themeSetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme"
            android:textColor="?attr/daymarkTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="18dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/themeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/system"
            android:textColor="?attr/daymarkTextSecondary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/syncEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backend: connected endpoint configured"
            android:textColor="?attr/daymarkTextSecondary"
            android:textSize="12sp"
            android:paddingTop="28dp" />
    </LinearLayout>
</ScrollView>
