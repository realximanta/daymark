<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/daymarkBackground">

    <!-- 📖 Header block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp">

        <TextView
            style="@style/TextSectionLabel"
            android:text="YOUR STORY SO FAR" />

        <TextView
            style="@style/TextHeadline"
            android:text="Journal history"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/TextBody"
            android:text="Every day has something worth remembering."
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />
    </LinearLayout>

    <!-- 🔍 Search -->
    <EditText
        android:id="@+id/historySearch"
        style="@style/Widget.Daymark.Input"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:hint="Search your memories"
        android:inputType="text"
        android:singleLine="true"
        android:contentDescription="Search your journal entries" />

    <!-- 💡 Swipe hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Swipe an entry left to delete"
        android:textSize="11sp"
        android:textColor="?attr/daymarkTextSecondary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp" />

    <!-- 📭 Empty state (shown when list is empty) -->
    <LinearLayout
        android:id="@+id/historyEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📭"
            android:textSize="64sp"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your story starts here."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/daymarkTextPrimary"
            android:gravity="center"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Write your first entry from the home screen."
            android:textSize="13sp"
            android:textColor="?attr/daymarkTextSecondary"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:maxWidth="280dp" />
    </LinearLayout>

    <!-- 📜 Entry list -->
    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="11dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="26dp"
        android:scrollbars="none" />
</LinearLayout>
