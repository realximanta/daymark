<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/daymarkBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history"
        android:textColor="?attr/daymarkTextPrimary"
        android:textSize="25sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/historySearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_entries"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/historyEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_entries"
        android:textColor="?attr/daymarkTextSecondary"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="8dp"
        android:divider="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingTop="10dp" />
</LinearLayout>
