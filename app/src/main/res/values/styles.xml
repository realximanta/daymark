<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme — default -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_green</item>
        <item name="android:colorPrimaryDark">@color/brand_green_dark</item>
        <item name="android:colorAccent">@color/brand_green</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dark theme — referenced by name from every Activity's applyTheme() -->
    <style name="AppTheme_Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand_green</item>
        <item name="android:colorPrimaryDark">@color/brand_green_dark</item>
        <item name="android:colorAccent">@color/brand_green</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
